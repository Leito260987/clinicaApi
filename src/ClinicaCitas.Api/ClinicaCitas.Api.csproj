<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClinicaCitas.Api</RootNamespace>
    <!-- Permite ejecutar el proyecto aunque solo esté instalado un runtime más nuevo (.NET 9 o 10) -->
    <RollForward>Major</RollForward>
    <!-- Genera el XML de comentarios que Swagger usa para documentar los endpoints -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
